# Modelo das variáveis de ambiente do backend.
# Copie para ".env" e troque os valores fictícios pelos reais.

# --- Banco de dados PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=busuff
DB_USER=busuff
DB_PASSWORD=troque-esta-senha

# --- Broker MQTT (o backend conecta por TCP, não por WebSocket) ---
MQTT_HOST=localhost
MQTT_PORT=1883

# --- API REST ---
# Origens que podem chamar a API pelo navegador, separadas por vírgula ("*" = qualquer uma)
CORS_ORIGINS=*